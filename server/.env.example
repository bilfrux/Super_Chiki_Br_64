# Copy to .env (gitignored). Loaded by `npm start`.
ADMIN_KEY=dev-admin-key
PORT=8080
# Only if phones must use a different address than this machine (tunnel / deployment):
# PUBLIC_URL=https://your-host.example.com

# --- Monad Testnet (optional; see ../MONAD_RESOURCES.md) ---
# Simulated chain activity, chainMode "DEMO" (no network):
# DEMO_MODE=true
# Real Monad Testnet: BOTH must be set. The relayer key must be a throwaway testnet key, never committed.
# RELAYER_PRIVATE_KEY=0x...
# BOOST_LEDGER_ADDRESS=0x...            (from deploying contracts/src/BoostLedger.sol)
# Defaults are the official testnet values (chain id 10143, testnet-rpc.monad.xyz + rpc-testnet.monadinfra.com):
# CHAIN_ID=10143
# MONAD_RPC_URLS=https://testnet-rpc.monad.xyz,https://rpc-testnet.monadinfra.com
# CHAIN_FLUSH_MS=2000        one batched transaction per window
# CHAIN_GAS_LIMIT=150000     gas is charged on the limit on Monad
